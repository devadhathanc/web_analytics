# MongoDB Connection Configuration
# -------------------------------------------------------------
# 1. For MongoDB Atlas (Free Cloud Cluster):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/causal_analytics?retryWrites=true&w=majority
#
# 2. For Local MongoDB (Default):
MONGODB_URI=mongodb://localhost:27017/causal_analytics

# Server Port
PORT=5000
FLASK_ENV=development
